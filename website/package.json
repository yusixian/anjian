{
  "name": "anjian-docs",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node scripts/release-pages.mjs && next build",
    "dev": "node scripts/release-pages.mjs && next dev --hostname 127.0.0.1 --port 3100",
    "postinstall": "node scripts/release-pages.mjs && fumadocs-mdx",
    "test": "node --test scripts/*.test.mjs",
    "typecheck": "node scripts/release-pages.mjs && fumadocs-mdx && next typegen && tsc --noEmit"
  },
  "dependencies": {
    "fumadocs-core": "16.18.4",
    "fumadocs-mdx": "15.5.3",
    "fumadocs-ui": "16.18.4",
    "lucide-react": "^0.577.0",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/mdx": "^2.0.13",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.8"
  },
  "packageManager": "pnpm@10.28.2"
}
