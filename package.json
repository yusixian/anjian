{
  "name": "anjian-workflow",
  "version": "0.3.1",
  "private": true,
  "description": "Anjian workflow and local agent integrations",
  "keywords": [
    "pi-package",
    "skills",
    "tdd",
    "debugging",
    "collaboration",
    "workflow"
  ],
  "license": "MIT",
  "type": "module",
  "main": ".opencode/plugins/anjian.js",
  "scripts": {
    "changeset": "changeset",
    "format": "prettier --write .",
    "lint": "eslint . --fix",
    "prepare": "simple-git-hooks",
    "release:check": "node scripts/release/version.mjs --check",
    "release:version": "node scripts/release/version.mjs",
    "test:release": "node --test tests/release-checks/*.test.mjs tests/versioning/*.test.mjs"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*.{js,jsx,mjs,cjs,ts,tsx,yml,yaml}": "eslint --fix",
    "*": "prettier --write --ignore-unknown"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@lobehub/eslint-config": "^2.1.7",
    "@lobehub/prettier-config": "^2.1.7",
    "eslint": "^10.13.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-packagejson": "^3.0.3",
    "prettier-plugin-sh": "^0.20.2",
    "prettier-plugin-sort-json": "^4.2.0",
    "simple-git-hooks": "^2.14.0",
    "typescript": "^6.0.3"
  },
  "pi": {
    "extensions": [
      "./.pi/extensions/anjian.ts"
    ],
    "skills": [
      "./skills"
    ]
  }
}
